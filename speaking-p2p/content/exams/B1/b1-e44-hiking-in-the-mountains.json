          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e44-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows hikers walking in the mountains. Please tell us what you can see.",
          "audio": "audio/B1/b1-e44-hiking-in-the-mountains/p2-a.mp3",
          "audioMs": 7800
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
