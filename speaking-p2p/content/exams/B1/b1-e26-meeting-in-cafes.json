      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p1-intro.mp3",
          "audioMs": 6600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you go to cafes?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p1-q1.mp3",
          "audioMs": 3100
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what do you usually have when you go to a cafe?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p1-q2.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a cafe you like.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p1-q3.mp3",
          "audioMs": 3700
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer talking to friends in a cafe or at home?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p1-q4.mp3",
          "audioMs": 5200
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how often do you meet your friends?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p1-q5.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, where are you going to meet your friends this weekend?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p1-q6.mp3",
          "audioMs": 4500
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e26-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows two friends talking in a cafe. Please tell us what you can see.",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p2-a.mp3",
          "audioMs": 7700
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e26-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a man working in a cafe. Please tell us what you can see.",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p2-b.mp3",
          "audioMs": 7500
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e26-meeting-in-cafes",
          "text": "A group of friends wants to find a place to meet every week. Here are some places. Talk together about the different places, and say which would be the best.",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p3-discuss.mp3",
          "audioMs": 9900
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about cafes and meeting people.",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p4-intro.mp3",
          "audioMs": 5400
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is important to meet friends often? Why?",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p4-q1.mp3",
          "audioMs": 4200
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think people talk to each other less nowadays?",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p4-q2.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what do you like to talk about with friends?",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p4-q3.mp3",
          "audioMs": 3800
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it a good idea to study or work in a cafe?",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p4-q4.mp3",
          "audioMs": 3800
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, would you like to have your own cafe?",
          "audio": "audio/B1/b1-e26-meeting-in-cafes/p4-q5.mp3",
          "audioMs": 3700
        }
      ]
    }
