          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, where do you usually buy your clothes?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p1-q1.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you enjoy shopping? Why or why not?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p1-q2.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about something you bought recently.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p1-q3.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer shopping with friends or on your own?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p1-q4.mp3",
          "audioMs": 4700
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what do you like to spend your money on?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p1-q5.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what would you like to buy next month?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p1-q6.mp3",
          "audioMs": 3600
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
