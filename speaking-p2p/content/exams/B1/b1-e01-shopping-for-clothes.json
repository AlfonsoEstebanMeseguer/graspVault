          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e01-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows people choosing clothes in a clothes shop. Please tell us what you can see.",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p2-a.mp3",
          "audioMs": 8500
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e01-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a man shopping on the internet at home. Please tell us what you can see.",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p2-b.mp3",
          "audioMs": 8200
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e01-shopping-for-clothes",
          "text": "A friend of yours wants to buy a birthday present for his sister. Here are some places where he could buy it. Talk together about the different places, and say which would be the best.",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p3-discuss.mp3",
          "audioMs": 11400
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about shopping.",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p4-intro.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think shopping online is better than going to the shops? Why?",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p4-q1.mp3",
          "audioMs": 4900
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think young people spend too much money on clothes?",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p4-q2.mp3",
          "audioMs": 4900
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you ever buy second-hand things? Why or why not?",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p4-q3.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "What is the most difficult thing to choose when you buy a present for someone?",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p4-q4.mp3",
          "audioMs": 4900
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, what is your favourite shop in your town?",
          "audio": "audio/B1/b1-e01-shopping-for-clothes/p4-q5.mp3",
