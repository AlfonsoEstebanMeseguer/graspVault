{
  "id": "b1-e16-going-to-the-cinema",
  "level": "B1",
  "version": 1,
  "topic": "Going to the cinema",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p1-intro.mp3",
          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how often do you go to the cinema?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p1-q1.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what kind of films do you like?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p1-q2.mp3",
          "audioMs": 3400
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about the last film you saw.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p1-q3.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer watching films at home or at the cinema?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p1-q4.mp3",
          "audioMs": 4900
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, who do you usually go to see films with?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p1-q5.mp3",
          "audioMs": 4100
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what film would you like to see next?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p1-q6.mp3",
          "audioMs": 3800
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e16-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows people watching a film in a cinema. Please tell us what you can see.",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p2-a.mp3",
          "audioMs": 8000
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e16-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a family watching a film at home. Please tell us what you can see.",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p2-b.mp3",
          "audioMs": 7900
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e16-going-to-the-cinema",
          "text": "A group of friends want to spend an evening together watching a film. Here are some ways they could do it. Talk together about the different ideas, and say which would be the best evening.",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p3-discuss.mp3",
          "audioMs": 11600
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about films and cinema.",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p4-intro.mp3",
          "audioMs": 5000
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think the cinema is more fun than watching a film at home? Why?",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p4-q1.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think films are too expensive nowadays?",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p4-q2.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you ever watch films in English?",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p4-q3.mp3",
          "audioMs": 3600
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Can a film teach you something? Why or why not?",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p4-q4.mp3",
          "audioMs": 3700
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, who is your favourite actor, and why?",
          "audio": "audio/B1/b1-e16-going-to-the-cinema/p4-q5.mp3",
          "audioMs": 3900
        }
      ]
    }
  ]
}
