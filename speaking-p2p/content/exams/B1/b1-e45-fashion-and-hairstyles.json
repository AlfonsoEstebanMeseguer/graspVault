  "topic": "Fashion and hairstyles",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p1-intro.mp3",
          "audioMs": 6500
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you follow fashion?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p1-q1.mp3",
          "audioMs": 2900
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how often do you change your hairstyle?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p1-q2.mp3",
          "audioMs": 3800
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about the clothes you wear at the weekend.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p1-q3.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you like wearing hats or glasses?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p1-q4.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, who do you usually go shopping with?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p1-q5.mp3",
          "audioMs": 3700
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how will fashion change in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e45-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a man having his hair cut. Please tell us what you can see.",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p2-a.mp3",
          "audioMs": 7600
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e45-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows models in a fashion show. Please tell us what you can see.",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p2-b.mp3",
          "audioMs": 7500
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e45-fashion-and-hairstyles",
          "text": "A friend of yours is going to a job interview and wants to look good. Here are some things he could do. Talk together about the different things, and say which would be the best.",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p3-discuss.mp3",
          "audioMs": 10900
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about fashion and style.",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p4-intro.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think the way you look is important? Why or why not?",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p4-q1.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think fashion is too expensive?",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p4-q2.mp3",
          "audioMs": 3800
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you ever wear clothes that your friends or family wear?",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p4-q3.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it good that everybody wears similar clothes?",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p4-q4.mp3",
          "audioMs": 3700
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what is your favourite colour to wear?",
          "audio": "audio/B1/b1-e45-fashion-and-hairstyles/p4-q5.mp3",
          "audioMs": 3700
        }
      ]
    }
  ]
