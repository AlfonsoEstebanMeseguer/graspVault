{
  "id": "b1-e32-healthy-eating",
  "level": "B1",
  "version": 1,
  "topic": "Healthy eating",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e32-healthy-eating/p1-intro.mp3",
          "audioMs": 6600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you eat healthy food?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e32-healthy-eating/p1-q1.mp3",
          "audioMs": 3000
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what is your favourite fruit or vegetable?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e32-healthy-eating/p1-q2.mp3",
          "audioMs": 4300
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a meal you did not enjoy.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e32-healthy-eating/p1-q3.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer eating at home or at school?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e32-healthy-eating/p1-q4.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how often do you eat sweets?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e32-healthy-eating/p1-q5.mp3",
          "audioMs": 3300
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what are you going to have for dinner tonight?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e32-healthy-eating/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e32-healthy-eating/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e32-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a woman buying fresh vegetables. Please tell us what you can see.",
          "audio": "audio/B1/b1-e32-healthy-eating/p2-a.mp3",
          "audioMs": 8100
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e32-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows teenagers eating fast food. Please tell us what you can see.",
          "audio": "audio/B1/b1-e32-healthy-eating/p2-b.mp3",
          "audioMs": 7900
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e32-healthy-eating/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e32-healthy-eating",
          "text": "A school wants its students to eat in a healthier way. Here are some ideas. Talk together about the different ideas, and say which would be the best for the school.",
          "audio": "audio/B1/b1-e32-healthy-eating/p3-discuss.mp3",
          "audioMs": 10400
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about healthy eating.",
          "audio": "audio/B1/b1-e32-healthy-eating/p4-intro.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is difficult to eat healthy food? Why or why not?",
          "audio": "audio/B1/b1-e32-healthy-eating/p4-q1.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think healthy food is more expensive than fast food?",
          "audio": "audio/B1/b1-e32-healthy-eating/p4-q2.mp3",
          "audioMs": 5300
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what do you think children should eat for breakfast?",
          "audio": "audio/B1/b1-e32-healthy-eating/p4-q3.mp3",
          "audioMs": 4200
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Should the government stop advertising fast food?",
          "audio": "audio/B1/b1-e32-healthy-eating/p4-q4.mp3",
          "audioMs": 3600
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, have you ever tried a diet?",
          "audio": "audio/B1/b1-e32-healthy-eating/p4-q5.mp3",
          "audioMs": 3300
        }
      ]
    }
  ]
}
