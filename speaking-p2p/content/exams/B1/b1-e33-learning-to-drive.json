{
  "id": "b1-e33-learning-to-drive",
  "level": "B1",
  "version": 1,
  "topic": "Learning to drive",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e33-learning-to-drive/p1-intro.mp3",
          "audioMs": 6500
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you have a driving licence?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e33-learning-to-drive/p1-q1.mp3",
          "audioMs": 3500
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, does your family have a car?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e33-learning-to-drive/p1-q2.mp3",
          "audioMs": 3400
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a car journey you remember.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e33-learning-to-drive/p1-q3.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer being a passenger or driving?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e33-learning-to-drive/p1-q4.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you think cars are important in your family's life?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e33-learning-to-drive/p1-q5.mp3",
          "audioMs": 4900
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, would you like to have your own car in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e33-learning-to-drive/p1-q6.mp3",
          "audioMs": 4300
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e33-learning-to-drive/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e33-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a woman having a driving lesson. Please tell us what you can see.",
          "audio": "audio/B1/b1-e33-learning-to-drive/p2-a.mp3",
          "audioMs": 8000
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e33-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows cars in a traffic jam. Please tell us what you can see.",
          "audio": "audio/B1/b1-e33-learning-to-drive/p2-b.mp3",
          "audioMs": 7500
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e33-learning-to-drive/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e33-learning-to-drive",
          "text": "A friend of yours is 18 and wants to get a car. Here are some things he should think about before he buys one. Talk together about the different things, and say which is the most important.",
          "audio": "audio/B1/b1-e33-learning-to-drive/p3-discuss.mp3",
          "audioMs": 12100
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about cars and driving.",
          "audio": "audio/B1/b1-e33-learning-to-drive/p4-intro.mp3",
          "audioMs": 5000
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think young people need a car? Why or why not?",
          "audio": "audio/B1/b1-e33-learning-to-drive/p4-q1.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, why do you think some young people do not want to learn to drive?",
          "audio": "audio/B1/b1-e33-learning-to-drive/p4-q2.mp3",
          "audioMs": 5300
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what are the good things about owning a car?",
          "audio": "audio/B1/b1-e33-learning-to-drive/p4-q3.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Would you like to try a car that drives itself?",
          "audio": "audio/B1/b1-e33-learning-to-drive/p4-q4.mp3",
          "audioMs": 3400
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you think driving is dangerous?",
          "audio": "audio/B1/b1-e33-learning-to-drive/p4-q5.mp3",
          "audioMs": 3800
        }
      ]
    }
  ]
}
