          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e12-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a man painting at home. Please tell us what you can see.",
          "audio": "audio/B1/b1-e12-hobbies-at-home/p2-a.mp3",
          "audioMs": 7300
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e12-b1"
