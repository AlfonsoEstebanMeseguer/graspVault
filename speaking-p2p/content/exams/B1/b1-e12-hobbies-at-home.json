          "audioMs": 4000
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think hobbies are important in our lives? Why?",
          "audio": "audio/B1/b1-e12-hobbies-at-home/p4-q1.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, is it better to have a hobby that is cheap or one that costs a lot of money?",
          "audio": "audio/B1/b1-e12-hobbies-at-home/p4-q2.mp3",
          "audioMs": 6400
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you think children should have hobbies after school?",
