          "audioMs": 4300
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Can a hobby become a job? Why or why not?",
          "audio": "audio/B1/b1-e12-hobbies-at-home/p4-q4.mp3",
          "audioMs": 3600
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
