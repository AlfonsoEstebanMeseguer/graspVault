          "audio": "audio/B1/b1-e12-hobbies-at-home/p1-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer hobbies you do alone or with other people?",
