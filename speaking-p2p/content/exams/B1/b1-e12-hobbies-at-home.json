          "audio": "audio/B1/b1-e12-hobbies-at-home/p1-q4.mp3",
          "audioMs": 4900
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how much time do you have for hobbies during the week?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e12-hobbies-at-home/p1-q5.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, is there a hobby you would like to start?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e12-hobbies-at-home/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
