{
  "id": "b1-e34-flying-abroad",
  "level": "B1",
  "version": 1,
  "topic": "Flying abroad",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e34-flying-abroad/p1-intro.mp3",
          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, have you ever travelled by plane?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e34-flying-abroad/p1-q1.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what do you like about airports?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e34-flying-abroad/p1-q2.mp3",
          "audioMs": 3400
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about your last trip abroad.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e34-flying-abroad/p1-q3.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer to travel alone or with other people?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e34-flying-abroad/p1-q4.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what do you do to pass the time on a long journey?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e34-flying-abroad/p1-q5.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, which country would you like to fly to next?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e34-flying-abroad/p1-q6.mp3",
          "audioMs": 4200
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e34-flying-abroad/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e34-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows people waiting at an airport. Please tell us what you can see.",
          "audio": "audio/B1/b1-e34-flying-abroad/p2-a.mp3",
          "audioMs": 7600
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e34-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a view from an aeroplane window. Please tell us what you can see.",
          "audio": "audio/B1/b1-e34-flying-abroad/p2-b.mp3",
          "audioMs": 7900
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e34-flying-abroad/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e34-flying-abroad",
          "text": "A family is going on a long flight with two young children. Here are some things they could take to make the flight easier. Talk together about the different things, and say which would be the most useful.",
          "audio": "audio/B1/b1-e34-flying-abroad/p3-discuss.mp3",
          "audioMs": 12600
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about air travel.",
          "audio": "audio/B1/b1-e34-flying-abroad/p4-intro.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think flying is the best way to travel long distances? Why?",
          "audio": "audio/B1/b1-e34-flying-abroad/p4-q1.mp3",
          "audioMs": 5300
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think flights are too cheap?",
          "audio": "audio/B1/b1-e34-flying-abroad/p4-q2.mp3",
          "audioMs": 3400
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what do you do to feel comfortable on a long journey?",
          "audio": "audio/B1/b1-e34-flying-abroad/p4-q3.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it a good idea to travel with young children?",
          "audio": "audio/B1/b1-e34-flying-abroad/p4-q4.mp3",
          "audioMs": 3600
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, have you ever lost something while travelling?",
          "audio": "audio/B1/b1-e34-flying-abroad/p4-q5.mp3",
          "audioMs": 3900
        }
      ]
    }
  ]
}
