          "audioMs": 4400
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, have you ever met someone famous?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e37-famous-people/p1-q4.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you follow any famous people online?",
