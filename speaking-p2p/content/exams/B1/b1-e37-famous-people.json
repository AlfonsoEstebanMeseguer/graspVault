          "audio": "audio/B1/b1-e37-famous-people/p1-q5.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what would you do if you became famous?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e37-famous-people/p1-q6.mp3",
          "audioMs": 4000
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
