          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e37-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a singer with her fans. Please tell us what you can see.",
          "audio": "audio/B1/b1-e37-famous-people/p2-a.mp3",
          "audioMs": 7200
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e37-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a sportsman celebrating a victory. Please tell us what you can see.",
          "audio": "audio/B1/b1-e37-famous-people/p2-b.mp3",
          "audioMs": 8300
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e37-famous-people/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e37-famous-people",
          "text": "A group of students wants to invite a famous person to visit their school. Here are some kinds of people they could invite. Talk together about the different people, and say which would be the best.",
          "audio": "audio/B1/b1-e37-famous-people/p3-discuss.mp3",
          "audioMs": 12100
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about famous people.",
