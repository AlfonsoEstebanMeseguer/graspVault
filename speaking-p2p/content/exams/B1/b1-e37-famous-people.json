          "audioMs": 4300
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you think some famous people earn too much money?",
          "audio": "audio/B1/b1-e37-famous-people/p4-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Would you like to live like a famous person for a day?",
