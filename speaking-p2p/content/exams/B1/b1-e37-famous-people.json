          "audioMs": 4600
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think famous people are good examples for young people? Why or why not?",
          "audio": "audio/B1/b1-e37-famous-people/p4-q1.mp3",
          "audioMs": 5600
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, what is the difficult side of being famous?",
