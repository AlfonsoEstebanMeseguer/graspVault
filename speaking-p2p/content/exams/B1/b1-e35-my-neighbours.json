{
  "id": "b1-e35-my-neighbours",
  "level": "B1",
  "version": 1,
  "topic": "My neighbours",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e35-my-neighbours/p1-intro.mp3",
          "audioMs": 6600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you know your neighbours?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e35-my-neighbours/p1-q1.mp3",
          "audioMs": 3000
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what is your neighbourhood like?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e35-my-neighbours/p1-q2.mp3",
          "audioMs": 3300
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a neighbour you like.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e35-my-neighbours/p1-q3.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer a quiet neighbourhood or a lively one?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e35-my-neighbours/p1-q4.mp3",
          "audioMs": 4900
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what do you do in your neighbourhood at weekends?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e35-my-neighbours/p1-q5.mp3",
          "audioMs": 4300
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, would you like to live in the same place in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e35-my-neighbours/p1-q6.mp3",
          "audioMs": 4600
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e35-my-neighbours/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e35-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows two neighbours talking in their gardens. Please tell us what you can see.",
          "audio": "audio/B1/b1-e35-my-neighbours/p2-a.mp3",
          "audioMs": 8000
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e35-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows friends helping someone move into a new home. Please tell us what you can see.",
          "audio": "audio/B1/b1-e35-my-neighbours/p2-b.mp3",
          "audioMs": 8600
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e35-my-neighbours/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e35-my-neighbours",
          "text": "A new family has moved in next door and your class wants to welcome them. Here are some ideas. Talk together about the different ideas, and say which would be the best way to welcome them.",
          "audio": "audio/B1/b1-e35-my-neighbours/p3-discuss.mp3",
          "audioMs": 12000
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about neighbours and neighbourhood.",
          "audio": "audio/B1/b1-e35-my-neighbours/p4-intro.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is important to know your neighbours? Why?",
          "audio": "audio/B1/b1-e35-my-neighbours/p4-q1.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think people are friendlier in small towns?",
          "audio": "audio/B1/b1-e35-my-neighbours/p4-q2.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what problems can you have with neighbours?",
          "audio": "audio/B1/b1-e35-my-neighbours/p4-q3.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it a good idea to have a party for the whole street?",
          "audio": "audio/B1/b1-e35-my-neighbours/p4-q4.mp3",
          "audioMs": 3800
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, how can we help neighbours who are alone?",
          "audio": "audio/B1/b1-e35-my-neighbours/p4-q5.mp3",
          "audioMs": 3800
        }
      ]
    }
  ]
}
