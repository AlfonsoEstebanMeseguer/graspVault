{
  "id": "b1-e15-reading-books",
  "level": "B1",
  "version": 1,
  "topic": "Reading books",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e15-reading-books/p1-intro.mp3",
          "audioMs": 6500
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you like reading?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e15-reading-books/p1-q1.mp3",
          "audioMs": 2700
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what kind of books do you enjoy?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e15-reading-books/p1-q2.mp3",
          "audioMs": 3500
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a book you have read recently.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e15-reading-books/p1-q3.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer paper books or books on a screen?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e15-reading-books/p1-q4.mp3",
          "audioMs": 4500
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, where do you usually read?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e15-reading-books/p1-q5.mp3",
          "audioMs": 3200
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, are you going to read anything this summer?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e15-reading-books/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e15-reading-books/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e15-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a woman reading at home. Please tell us what you can see.",
          "audio": "audio/B1/b1-e15-reading-books/p2-a.mp3",
          "audioMs": 7400
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e15-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows children in a library. Please tell us what you can see.",
          "audio": "audio/B1/b1-e15-reading-books/p2-b.mp3",
          "audioMs": 7200
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e15-reading-books/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e15-reading-books",
          "text": "A town library wants more young people to come. Here are some ideas to make the library more popular. Talk together about the different ideas, and say which would be the best.",
          "audio": "audio/B1/b1-e15-reading-books/p3-discuss.mp3",
          "audioMs": 11500
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about books and reading.",
          "audio": "audio/B1/b1-e15-reading-books/p4-intro.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think people read less than in the past? Why?",
          "audio": "audio/B1/b1-e15-reading-books/p4-q1.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think libraries are still important?",
          "audio": "audio/B1/b1-e15-reading-books/p4-q2.mp3",
          "audioMs": 4200
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what is a good book to give as a present?",
          "audio": "audio/B1/b1-e15-reading-books/p4-q3.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it better to read a book before you see the film?",
          "audio": "audio/B1/b1-e15-reading-books/p4-q4.mp3",
          "audioMs": 3500
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, should children read more at school?",
          "audio": "audio/B1/b1-e15-reading-books/p4-q5.mp3",
          "audioMs": 3600
        }
      ]
    }
  ]
}
