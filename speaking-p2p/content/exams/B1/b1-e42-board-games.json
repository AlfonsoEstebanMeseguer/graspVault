          "audioMs": 4800
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think games are only for children? Why or why not?",
          "audio": "audio/B1/b1-e42-board-games/p4-q1.mp3",
          "audioMs": 4300
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think some games teach useful things?",
