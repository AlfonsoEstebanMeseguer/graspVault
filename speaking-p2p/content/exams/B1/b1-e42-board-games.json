          "audioMs": 4300
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what game would you like to teach your friends?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e42-board-games/p1-q6.mp3",
          "audioMs": 4100
        }
      ]
    },
    {
