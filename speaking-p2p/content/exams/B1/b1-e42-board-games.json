          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e42-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a family playing a board game. Please tell us what you can see.",
          "audio": "audio/B1/b1-e42-board-games/p2-a.mp3",
          "audioMs": 7700
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e42-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows children playing a game outside. Please tell us what you can see.",
          "audio": "audio/B1/b1-e42-board-games/p2-b.mp3",
          "audioMs": 8000
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e42-board-games/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e42-board-games",
          "text": "A group of friends is going to spend a rainy weekend in a mountain house. Here are some games and activities they could bring. Talk together about the different ideas, and say which would be the best.",
          "audio": "audio/B1/b1-e42-board-games/p3-discuss.mp3",
          "audioMs": 12800
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about games and fun.",
