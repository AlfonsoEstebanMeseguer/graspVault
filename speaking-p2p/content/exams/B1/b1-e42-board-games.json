          "audioMs": 4000
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a game you played with your family.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e42-board-games/p1-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you like winning?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e42-board-games/p1-q4.mp3",
          "audioMs": 2700
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you prefer card games or board games?",
