          "audioMs": 3800
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it better to play games on a screen or on a table?",
          "audio": "audio/B1/b1-e42-board-games/p4-q4.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, which game do you think is the most difficult?",
