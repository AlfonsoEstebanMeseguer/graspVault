        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e25-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows children in school uniforms. Please tell us what you can see.",
          "audio": "audio/B1/b1-e25-school-uniforms/p2-a.mp3",
          "audioMs": 7700
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e25-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows students in their own clothes at school. Please tell us what you can see.",
          "audio": "audio/B1/b1-e25-school-uniforms/p2-b.mp3",
          "audioMs": 8200
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e25-school-uniforms/p3-intro.mp3",
          "audioMs": 6700
        },
        {
