          "audioMs": 4100
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what are you going to wear to the next party?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e25-school-uniforms/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
