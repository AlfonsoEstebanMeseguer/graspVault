          "audioMs": 4300
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer comfortable clothes or fashionable clothes?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e25-school-uniforms/p1-q4.mp3",
          "audioMs": 5200
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how do you choose what to wear every day?",
