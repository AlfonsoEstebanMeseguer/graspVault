  "version": 1,
  "topic": "Friends",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e17-friends/p1-intro.mp3",
          "audioMs": 6600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you have a lot of friends?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e17-friends/p1-q1.mp3",
          "audioMs": 3200
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how did you meet your best friend?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e17-friends/p1-q2.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about something nice you did with a friend.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e17-friends/p1-q3.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer going out in a big group or with one friend?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e17-friends/p1-q4.mp3",
          "audioMs": 5200
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how often do you see your friends?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e17-friends/p1-q5.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what are you going to do with your friends next weekend?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e17-friends/p1-q6.mp3",
          "audioMs": 4700
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e17-friends/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e17-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a group of friends laughing in a cafe. Please tell us what you can see.",
          "audio": "audio/B1/b1-e17-friends/p2-a.mp3",
          "audioMs": 8200
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e17-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows two older men fishing together. Please tell us what you can see.",
          "audio": "audio/B1/b1-e17-friends/p2-b.mp3",
          "audioMs": 7800
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e17-friends/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e17-friends",
          "text": "Your friend is feeling sad because his best friend has moved to another city. Here are some things he could do. Talk together about the different ideas, and say which would be the best.",
          "audio": "audio/B1/b1-e17-friends/p3-discuss.mp3",
          "audioMs": 11700
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about friends and friendship.",
          "audio": "audio/B1/b1-e17-friends/p4-intro.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is easy to stay friends when you live far away? Why?",
          "audio": "audio/B1/b1-e17-friends/p4-q1.mp3",
          "audioMs": 4900
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, what is the most important thing in a good friend?",
          "audio": "audio/B1/b1-e17-friends/p4-q2.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you think you can make real friends on the internet?",
          "audio": "audio/B1/b1-e17-friends/p4-q3.mp3",
          "audioMs": 4900
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it better to have a few close friends or many friends?",
          "audio": "audio/B1/b1-e17-friends/p4-q4.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, have you ever helped a friend with a problem?",
          "audio": "audio/B1/b1-e17-friends/p4-q5.mp3",
          "audioMs": 4000
        }
      ]
    }
  ]
