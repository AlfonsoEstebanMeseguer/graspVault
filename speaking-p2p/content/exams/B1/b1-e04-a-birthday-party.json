  "version": 1,
  "topic": "A birthday party",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e04-a-birthday-party/p1-intro.mp3",
          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how do you usually celebrate your birthday?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e04-a-birthday-party/p1-q1.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, tell us about a party you enjoyed.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e04-a-birthday-party/p1-q2.mp3",
          "audioMs": 3800
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what is your favourite day of the year? Why?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e04-a-birthday-party/p1-q3.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you like giving presents to people?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e04-a-birthday-party/p1-q4.mp3",
          "audioMs": 3700
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, who do you spend most time with at weekends?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e04-a-birthday-party/p1-q5.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what are you going to do for your next birthday?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e04-a-birthday-party/p1-q6.mp3",
          "audioMs": 4000
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e04-a-birthday-party/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e04-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a group of friends celebrating a birthday. Please tell us what you can see.",
          "audio": "audio/B1/b1-e04-a-birthday-party/p2-a.mp3",
          "audioMs": 8600
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e04-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a family dancing at a wedding. Please tell us what you can see.",
          "audio": "audio/B1/b1-e04-a-birthday-party/p2-b.mp3",
          "audioMs": 7700
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e04-a-birthday-party/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e04-a-birthday-party",
          "text": "Your friend is going to have a birthday party and wants it to be special. Here are some things she could do. Talk together about the different ideas, and say which would be the best for the party.",
          "audio": "audio/B1/b1-e04-a-birthday-party/p3-discuss.mp3",
          "audioMs": 12000
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about celebrations.",
          "audio": "audio/B1/b1-e04-a-birthday-party/p4-intro.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you prefer big parties or small parties? Why?",
          "audio": "audio/B1/b1-e04-a-birthday-party/p4-q1.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, what do you think is a good present for a friend?",
          "audio": "audio/B1/b1-e04-a-birthday-party/p4-q2.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, is there a celebration in your country that you really like?",
          "audio": "audio/B1/b1-e04-a-birthday-party/p4-q3.mp3",
          "audioMs": 5500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think people spend too much money on parties and presents?",
          "audio": "audio/B1/b1-e04-a-birthday-party/p4-q4.mp3",
          "audioMs": 4200
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what is the best way to say thank you for a present?",
          "audio": "audio/B1/b1-e04-a-birthday-party/p4-q5.mp3",
          "audioMs": 4400
        }
      ]
    }
  ]
