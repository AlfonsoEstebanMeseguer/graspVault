{
  "id": "b2-e15-live-music",
  "level": "B2",
  "version": 1,
  "topic": "Live music",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. First of all, we'd like to know something about you.",
          "audio": "audio/B2/b2-e15-live-music/p1-intro.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what kind of music do you listen to when you are at home?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e15-live-music/p1-q1.mp3",
          "audioMs": 4900
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how important is music in your life?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e15-live-music/p1-q2.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, have you ever been to a concert?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e15-live-music/p1-q3.mp3",
          "audioMs": 3500
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you play an instrument or sing?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e15-live-music/p1-q4.mp3",
          "audioMs": 3700
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you two photographs. I'd like you to talk about them on your own for about a minute, and also to answer a question about your partner's photographs.",
          "audio": "audio/B2/b2-e15-live-music/p2-intro.mp3",
          "audioMs": 13000
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b2-e15-a1",
            "b2-e15-a2"
          ],
          "text": "Candidate A, your photographs show people listening to live music. Compare the photographs, and say what the people might enjoy about these events.",
          "audio": "audio/B2/b2-e15-live-music/p2-a.mp3",
          "audioMs": 10100
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, which of these events would you prefer to go to? Why?",
          "audio": "audio/B2/b2-e15-live-music/p2-a-follow.mp3",
          "audioMs": 5100
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b2-e15-b1",
            "b2-e15-b2"
          ],
          "text": "Candidate B, your photographs show people making music. Compare the photographs, and say why the people might have chosen to take part in these activities.",
          "audio": "audio/B2/b2-e15-live-music/p2-b.mp3",
          "audioMs": 10500
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, would you prefer to make music alone or with other people?",
          "audio": "audio/B2/b2-e15-live-music/p2-b-follow.mp3",
          "audioMs": 5100
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some things that can make a live concert special, and a question for you to discuss.",
          "audio": "audio/B2/b2-e15-live-music/p3-intro.mp3",
          "audioMs": 10600
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "b2-e15-live-music",
          "text": "Talk to each other about this question: How might these things make a concert special for the audience?",
          "audio": "audio/B2/b2-e15-live-music/p3-discuss.mp3",
          "audioMs": 6900
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "b2-e15-live-music",
          "text": "Now you have about a minute to decide together. Which is the most important?",
          "audio": "audio/B2/b2-e15-live-music/p3-decide.mp3",
          "audioMs": 5400
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about music and live events.",
          "audio": "audio/B2/b2-e15-live-music/p4-intro.mp3",
          "audioMs": 5500
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Some people say that listening to music online is better than going to a concert. What do you think?",
          "audio": "audio/B2/b2-e15-live-music/p4-q1.mp3",
          "audioMs": 6800
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, do you think tickets for big concerts are too expensive?",
          "audio": "audio/B2/b2-e15-live-music/p4-q2.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, should children learn a musical instrument at school?",
          "audio": "audio/B2/b2-e15-live-music/p4-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Can music change the way people feel about their lives?",
          "audio": "audio/B2/b2-e15-live-music/p4-q4.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, how has the way people listen to music changed over the years?",
          "audio": "audio/B2/b2-e15-live-music/p4-q5.mp3",
          "audioMs": 5700
        }
      ]
    }
  ]
}
