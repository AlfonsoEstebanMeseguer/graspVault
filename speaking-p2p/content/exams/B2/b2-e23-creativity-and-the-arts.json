{
  "id": "b2-e23-creativity-and-the-arts",
  "level": "B2",
  "version": 1,
  "topic": "Creativity and the arts",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. First of all, we'd like to know something about you.",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p1-intro.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you like going to art galleries or exhibitions?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p1-q1.mp3",
          "audioMs": 4700
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what creative things do you do?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p1-q2.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you think you are a creative person?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p1-q3.mp3",
          "audioMs": 3800
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what did you enjoy about art at school?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p1-q4.mp3",
          "audioMs": 4000
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you two photographs. I'd like you to talk about them on your own for about a minute, and also to answer a question about your partner's photographs.",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p2-intro.mp3",
          "audioMs": 13000
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b2-e23-a1",
            "b2-e23-a2"
          ],
          "text": "Candidate A, your photographs show people creating art. Compare the photographs, and say why the people might have chosen to create art in these places.",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p2-a.mp3",
          "audioMs": 10500
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, which kind of art do you prefer? Why?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p2-a-follow.mp3",
          "audioMs": 4100
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b2-e23-b1",
            "b2-e23-b2"
          ],
          "text": "Candidate B, your photographs show people interested in art. Compare the photographs, and say what they might be learning.",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p2-b.mp3",
          "audioMs": 8300
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, do you think art should be taught more at school?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p2-b-follow.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some ways to make art more popular, and a question for you to discuss.",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p3-intro.mp3",
          "audioMs": 9700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "b2-e23-creativity-and-the-arts",
          "text": "Talk to each other about this question: How might these ideas encourage more people to enjoy art?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p3-discuss.mp3",
          "audioMs": 7200
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "b2-e23-creativity-and-the-arts",
          "text": "Now you have about a minute to decide together. Which would be the most effective?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p3-decide.mp3",
          "audioMs": 5700
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about art and creativity.",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p4-intro.mp3",
          "audioMs": 5200
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Some people say that art is a luxury, not a necessity. What is your opinion?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p4-q1.mp3",
          "audioMs": 5700
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, do you think modern art is difficult to understand?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p4-q2.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, should governments give money to artists?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p4-q3.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Can street art be considered real art?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p4-q4.mp3",
          "audioMs": 3400
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, how can art help people who feel sad?",
          "audio": "audio/B2/b2-e23-creativity-and-the-arts/p4-q5.mp3",
          "audioMs": 4000
        }
      ]
    }
  ]
}
