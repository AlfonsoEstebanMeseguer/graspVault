{
  "id": "b2-e21-family-relationships",
  "level": "B2",
  "version": 1,
  "topic": "Family relationships",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. First of all, we'd like to know something about you.",
          "audio": "audio/B2/b2-e21-family-relationships/p1-intro.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how much time do you spend with your family?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e21-family-relationships/p1-q1.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, who in your family are you closest to?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e21-family-relationships/p1-q2.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you think families were closer in the past?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e21-family-relationships/p1-q3.mp3",
          "audioMs": 4300
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how do you celebrate special occasions with your family?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e21-family-relationships/p1-q4.mp3",
          "audioMs": 4900
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you two photographs. I'd like you to talk about them on your own for about a minute, and also to answer a question about your partner's photographs.",
          "audio": "audio/B2/b2-e21-family-relationships/p2-intro.mp3",
          "audioMs": 13000
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b2-e21-a1",
            "b2-e21-a2"
          ],
          "text": "Candidate A, your photographs show people in a family. Compare the photographs, and say how the people might be feeling.",
          "audio": "audio/B2/b2-e21-family-relationships/p2-a.mp3",
          "audioMs": 8200
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, do you get on well with the members of your family? Why or why not?",
          "audio": "audio/B2/b2-e21-family-relationships/p2-a-follow.mp3",
          "audioMs": 5800
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b2-e21-b1",
            "b2-e21-b2"
          ],
          "text": "Candidate B, your photographs show adults looking after children. Compare the photographs, and say what the people might enjoy about these situations.",
          "audio": "audio/B2/b2-e21-family-relationships/p2-b.mp3",
          "audioMs": 10500
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, who do you think has more influence on a child, parents or grandparents?",
          "audio": "audio/B2/b2-e21-family-relationships/p2-b-follow.mp3",
          "audioMs": 6300
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some things that can help family members get on well, and a question for you to discuss.",
          "audio": "audio/B2/b2-e21-family-relationships/p3-intro.mp3",
          "audioMs": 10600
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "b2-e21-family-relationships",
          "text": "Talk to each other about this question: How might these things help family members get on well?",
          "audio": "audio/B2/b2-e21-family-relationships/p3-discuss.mp3",
          "audioMs": 6300
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "b2-e21-family-relationships",
          "text": "Now you have about a minute to decide together. Which is the most important?",
          "audio": "audio/B2/b2-e21-family-relationships/p3-decide.mp3",
          "audioMs": 5400
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about family life.",
          "audio": "audio/B2/b2-e21-family-relationships/p4-intro.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Some people say that families are smaller and less close nowadays. What do you think?",
          "audio": "audio/B2/b2-e21-family-relationships/p4-q1.mp3",
          "audioMs": 5900
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, how do you think parents can help teenagers who find it difficult to talk?",
          "audio": "audio/B2/b2-e21-family-relationships/p4-q2.mp3",
          "audioMs": 6100
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, is it better for children to have brothers and sisters?",
          "audio": "audio/B2/b2-e21-family-relationships/p4-q3.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Do you think grandparents should help to bring up children?",
          "audio": "audio/B2/b2-e21-family-relationships/p4-q4.mp3",
          "audioMs": 3700
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, what traditions do you think families should keep?",
          "audio": "audio/B2/b2-e21-family-relationships/p4-q5.mp3",
          "audioMs": 4500
        }
      ]
    }
  ]
}
