<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the Supabase session (refresh token) lives in
     FlutterSharedPreferences.xml; it must not travel in cloud backups or
     device-to-device transfers (security audit 2026-11, hardening). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
