{
  "id": "b1-e22-festivals-in-town",
  "level": "B1",
  "version": 1,
  "topic": "Festivals in town",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e22-festivals-in-town/p1-intro.mp3",
          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, are there any festivals in your town?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e22-festivals-in-town/p1-q1.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what is the most important festival in your country?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e22-festivals-in-town/p1-q2.mp3",
          "audioMs": 4800
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a festival you went to.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e22-festivals-in-town/p1-q3.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you like crowds?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e22-festivals-in-town/p1-q4.mp3",
          "audioMs": 2800
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what food do people eat at festivals where you live?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e22-festivals-in-town/p1-q5.mp3",
          "audioMs": 4700
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, would you like to go to a festival in another country?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e22-festivals-in-town/p1-q6.mp3",
          "audioMs": 4800
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e22-festivals-in-town/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e22-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a colourful parade in the street. Please tell us what you can see.",
          "audio": "audio/B1/b1-e22-festivals-in-town/p2-a.mp3",
          "audioMs": 7800
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e22-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows people holding lanterns at a night festival. Please tell us what you can see.",
          "audio": "audio/B1/b1-e22-festivals-in-town/p2-b.mp3",
          "audioMs": 8600
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e22-festivals-in-town/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e22-festivals-in-town",
          "text": "Your town is planning a new festival for visitors and local people. Here are some ideas for the festival. Talk together about the different ideas, and say which would be the best.",
          "audio": "audio/B1/b1-e22-festivals-in-town/p3-discuss.mp3",
          "audioMs": 11600
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about local events.",
          "audio": "audio/B1/b1-e22-festivals-in-town/p4-intro.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think festivals are good for a town? Why?",
          "audio": "audio/B1/b1-e22-festivals-in-town/p4-q1.mp3",
          "audioMs": 3700
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think tourists enjoy local festivals?",
          "audio": "audio/B1/b1-e22-festivals-in-town/p4-q2.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what do you remember about a festival when you were a child?",
          "audio": "audio/B1/b1-e22-festivals-in-town/p4-q3.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Should festivals be free or should people pay to go in?",
          "audio": "audio/B1/b1-e22-festivals-in-town/p4-q4.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, would you like to help to organise a festival?",
          "audio": "audio/B1/b1-e22-festivals-in-town/p4-q5.mp3",
          "audioMs": 4200
        }
      ]
    }
  ]
}
