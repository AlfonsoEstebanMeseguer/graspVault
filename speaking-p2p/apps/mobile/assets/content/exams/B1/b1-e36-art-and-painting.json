          "audio": "audio/B1/b1-e36-art-and-painting/p1-q3.mp3",
          "audioMs": 4800
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer drawing or taking photos?",
