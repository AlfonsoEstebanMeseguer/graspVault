          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e36-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows an artist painting a picture. Please tell us what you can see.",
          "audio": "audio/B1/b1-e36-art-and-painting/p2-a.mp3",
          "audioMs": 7800
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e36-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows visitors in an art gallery. Please tell us what you can see.",
          "audio": "audio/B1/b1-e36-art-and-painting/p2-b.mp3",
          "audioMs": 7700
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e36-art-and-painting/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e36-art-and-painting",
          "text": "A town wants to put some art in its main square. Here are some ideas. Talk together about the different ideas, and say which would be the best for the square.",
          "audio": "audio/B1/b1-e36-art-and-painting/p3-discuss.mp3",
          "audioMs": 10100
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about art.",
