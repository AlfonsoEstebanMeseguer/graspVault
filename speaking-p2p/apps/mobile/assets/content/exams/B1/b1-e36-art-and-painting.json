          "audioMs": 4000
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think art is important in a town? Why or why not?",
          "audio": "audio/B1/b1-e36-art-and-painting/p4-q1.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, should children have more art lessons at school?",
          "audio": "audio/B1/b1-e36-art-and-painting/p4-q2.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what kind of art do you like most?",
          "audio": "audio/B1/b1-e36-art-and-painting/p4-q3.mp3",
          "audioMs": 3500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Should the government spend money on art?",
          "audio": "audio/B1/b1-e36-art-and-painting/p4-q4.mp3",
          "audioMs": 2800
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, would you like to go to an art class?",
          "audio": "audio/B1/b1-e36-art-and-painting/p4-q5.mp3",
