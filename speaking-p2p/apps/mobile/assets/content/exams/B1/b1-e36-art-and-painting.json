          "audio": "audio/B1/b1-e36-art-and-painting/p1-q4.mp3",
          "audioMs": 4300
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, is there anything creative you do at home?",
