          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e21-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a man recycling bottles. Please tell us what you can see.",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p2-a.mp3",
          "audioMs": 7600
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e21-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows volunteers cleaning a river bank. Please tell us what you can see.",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p2-b.mp3",
          "audioMs": 8000
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e21-recycling-and-the-environment",
          "text": "Your school wants to become more friendly to the environment. Here are some ideas. Talk together about the different ideas, and say which would be the best for the school.",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p3-discuss.mp3",
          "audioMs": 10500
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about the environment.",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p4-intro.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think young people care about the environment? Why or why not?",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p4-q1.mp3",
          "audioMs": 5000
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think it is easy to recycle in your town?",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p4-q2.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what can families do to produce less rubbish?",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p4-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Who should do more to protect the environment, people or companies?",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p4-q4.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, would you pay more for products that are good for the environment?",
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p4-q5.mp3",
          "audioMs": 5100
        }
      ]
    }
