          "audioMs": 6500
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you recycle at home?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p1-q1.mp3",
          "audioMs": 3200
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, is your town clean? Why or why not?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p1-q2.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a time you spent a day in nature.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p1-q3.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer walking or going by car for short trips?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p1-q4.mp3",
          "audioMs": 5100
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what do you do to save water or energy at home?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p1-q5.mp3",
          "audioMs": 4700
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what would you like to change about the place where you live?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e21-recycling-and-the-environment/p1-q6.mp3",
          "audioMs": 4600
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
