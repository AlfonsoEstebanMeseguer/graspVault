{
  "id": "b1-e47-tourists-in-my-country",
  "level": "B1",
  "version": 1,
  "topic": "Tourists in my country",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p1-intro.mp3",
          "audioMs": 6600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do many tourists visit your town?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p1-q1.mp3",
          "audioMs": 3700
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what do you show visitors from other countries?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p1-q2.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a tourist you met.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p1-q3.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer to visit famous places or quiet places?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p1-q4.mp3",
          "audioMs": 5400
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what do tourists often buy in your country?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p1-q5.mp3",
          "audioMs": 4300
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what place would you take a foreign friend to next month?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p1-q6.mp3",
          "audioMs": 4700
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e47-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows tourists on a boat trip. Please tell us what you can see.",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p2-a.mp3",
          "audioMs": 7400
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e47-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a souvenir stall in a tourist area. Please tell us what you can see.",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p2-b.mp3",
          "audioMs": 8400
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e47-tourists-in-my-country",
          "text": "A town wants more tourists to visit in the winter. Here are some ideas. Talk together about the different ideas, and say which would be the best for the town.",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p3-discuss.mp3",
          "audioMs": 10200
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about tourism.",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p4-intro.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think tourism is good for a town? Why or why not?",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p4-q1.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think there are too many tourists in some places?",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p4-q2.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what would you like tourists to know about your country?",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p4-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it better to visit a place with a guide or alone?",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p4-q4.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, have you ever been a tourist in your own town?",
          "audio": "audio/B1/b1-e47-tourists-in-my-country/p4-q5.mp3",
          "audioMs": 4400
        }
      ]
    }
  ]
}
