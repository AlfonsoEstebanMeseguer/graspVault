{
  "id": "b1-e18-life-in-the-countryside",
  "level": "B1",
  "version": 1,
  "topic": "Life in the countryside",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p1-intro.mp3",
          "audioMs": 6500
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you live in a town or in the countryside?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p1-q1.mp3",
          "audioMs": 4300
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what do you like about the place where you live?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p1-q2.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a visit you made to the countryside.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p1-q3.mp3",
          "audioMs": 4700
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer cities or small villages?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p1-q4.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how do you spend time with your neighbours?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p1-q5.mp3",
          "audioMs": 3800
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, where would you like to live in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e18-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a farmer working on a farm. Please tell us what you can see.",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p2-a.mp3",
          "audioMs": 7600
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e18-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a busy street in a big city. Please tell us what you can see.",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p2-b.mp3",
          "audioMs": 7800
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e18-life-in-the-countryside",
          "text": "A family is thinking about moving from a city to the countryside. Here are some things they should think about. Talk together about the different things, and say which is the most important.",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p3-discuss.mp3",
          "audioMs": 11900
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about town and country life.",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p4-intro.mp3",
          "audioMs": 5200
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think life is better in the countryside or in a city? Why?",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p4-q1.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think young people want to leave small villages?",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p4-q2.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what can you do in a city that you cannot do in the countryside?",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p4-q3.mp3",
          "audioMs": 5200
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Would you like to live on a farm?",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p4-q4.mp3",
          "audioMs": 2700
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, is it expensive to live in a big city?",
          "audio": "audio/B1/b1-e18-life-in-the-countryside/p4-q5.mp3",
          "audioMs": 4300
        }
      ]
    }
  ]
}
