{
  "id": "b1-e10-using-phones",
  "level": "B1",
  "version": 1,
  "topic": "Using phones",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e10-using-phones/p1-intro.mp3",
          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how often do you use your phone?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e10-using-phones/p1-q1.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what do you use your phone for most?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e10-using-phones/p1-q2.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about the first time you used a computer.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e10-using-phones/p1-q3.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer to send messages or to phone people?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e10-using-phones/p1-q4.mp3",
          "audioMs": 4800
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you play games on your phone?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e10-using-phones/p1-q5.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how do you think phones will change in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e10-using-phones/p1-q6.mp3",
          "audioMs": 4300
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e10-using-phones/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e10-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows teenagers looking at their phones. Please tell us what you can see.",
          "audio": "audio/B1/b1-e10-using-phones/p2-a.mp3",
          "audioMs": 7900
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e10-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows an older woman learning to use a tablet. Please tell us what you can see.",
          "audio": "audio/B1/b1-e10-using-phones/p2-b.mp3",
          "audioMs": 8400
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e10-using-phones/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e10-using-phones",
          "text": "A school wants to help its students use their phones in a more useful way. Here are some ideas. Talk together about the different ideas, and say which would be the most useful.",
          "audio": "audio/B1/b1-e10-using-phones/p3-discuss.mp3",
          "audioMs": 11600
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about technology and phones.",
          "audio": "audio/B1/b1-e10-using-phones/p4-intro.mp3",
          "audioMs": 5200
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think people spend too much time on their phones? Why?",
          "audio": "audio/B1/b1-e10-using-phones/p4-q1.mp3",
          "audioMs": 4300
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, is it a good idea to let young children have a phone?",
          "audio": "audio/B1/b1-e10-using-phones/p4-q2.mp3",
          "audioMs": 5000
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, how do phones help you with your studies?",
          "audio": "audio/B1/b1-e10-using-phones/p4-q3.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Are there places where people should not use their phones?",
          "audio": "audio/B1/b1-e10-using-phones/p4-q4.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what would you do if you had no phone for a week?",
          "audio": "audio/B1/b1-e10-using-phones/p4-q5.mp3",
          "audioMs": 4500
        }
      ]
    }
  ]
}
