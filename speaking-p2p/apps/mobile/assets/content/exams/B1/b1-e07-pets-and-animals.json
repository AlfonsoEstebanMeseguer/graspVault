          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you have a pet at home?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e07-pets-and-animals/p1-q1.mp3",
          "audioMs": 3000
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what is your favourite animal?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e07-pets-and-animals/p1-q2.mp3",
          "audioMs": 3400
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a time you saw an interesting animal.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e07-pets-and-animals/p1-q3.mp3",
          "audioMs": 5000
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you like going to the zoo?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e07-pets-and-animals/p1-q4.mp3",
          "audioMs": 3300
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you live in a house or a flat?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e07-pets-and-animals/p1-q5.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, would you like to have a pet in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e07-pets-and-animals/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e07-pets-and-animals/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e07-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a girl playing with her dog. Please tell us what you can see.",
          "audio": "audio/B1/b1-e07-pets-and-animals/p2-a.mp3",
          "audioMs": 7600
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e07-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a family looking at animals at a zoo. Please tell us what you can see.",
          "audio": "audio/B1/b1-e07-pets-and-animals/p2-b.mp3",
          "audioMs": 8100
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e07-pets-and-animals/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e07-pets-and-animals",
          "text": "A family wants to have a pet but they live in a small flat. Here are some animals they could choose. Talk together about the different animals, and say which would be the best pet for them.",
          "audio": "audio/B1/b1-e07-pets-and-animals/p3-discuss.mp3",
          "audioMs": 11800
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about animals.",
          "audio": "audio/B1/b1-e07-pets-and-animals/p4-intro.mp3",
          "audioMs": 4200
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is a good idea to keep animals in a flat? Why or why not?",
          "audio": "audio/B1/b1-e07-pets-and-animals/p4-q1.mp3",
          "audioMs": 5500
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think children learn anything from having a pet?",
          "audio": "audio/B1/b1-e07-pets-and-animals/p4-q2.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what is difficult about looking after a pet?",
          "audio": "audio/B1/b1-e07-pets-and-animals/p4-q3.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Should people keep wild animals in zoos?",
          "audio": "audio/B1/b1-e07-pets-and-animals/p4-q4.mp3",
          "audioMs": 3300
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, are there any animals you are afraid of?",
          "audio": "audio/B1/b1-e07-pets-and-animals/p4-q5.mp3",
          "audioMs": 3900
        }
      ]
    }
