{
  "id": "b1-e05-learning-english",
  "level": "B1",
  "version": 1,
  "topic": "Learning English",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e05-learning-english/p1-intro.mp3",
          "audioMs": 6600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how long have you been learning English?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e05-learning-english/p1-q1.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, why do you want to learn English?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e05-learning-english/p1-q2.mp3",
          "audioMs": 3300
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what do you find most difficult about English?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e05-learning-english/p1-q3.mp3",
          "audioMs": 4300
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you like speaking to people in English?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e05-learning-english/p1-q4.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about your favourite teacher.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e05-learning-english/p1-q5.mp3",
          "audioMs": 3800
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how do you hope to use English in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e05-learning-english/p1-q6.mp3",
          "audioMs": 4100
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e05-learning-english/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e05-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows students in a language classroom. Please tell us what you can see.",
          "audio": "audio/B1/b1-e05-learning-english/p2-a.mp3",
          "audioMs": 7800
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e05-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a young man learning English by watching a film. Please tell us what you can see.",
          "audio": "audio/B1/b1-e05-learning-english/p2-b.mp3",
          "audioMs": 8800
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e05-learning-english/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e05-learning-english",
          "text": "A friend of yours wants to improve her English quickly before a trip. Here are some things she could do. Talk together about the different ideas, and say which would be the best way to improve.",
          "audio": "audio/B1/b1-e05-learning-english/p3-discuss.mp3",
          "audioMs": 12100
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about learning languages.",
          "audio": "audio/B1/b1-e05-learning-english/p4-intro.mp3",
          "audioMs": 5000
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is easy to learn a language at school? Why or why not?",
          "audio": "audio/B1/b1-e05-learning-english/p4-q1.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think everybody should learn English?",
          "audio": "audio/B1/b1-e05-learning-english/p4-q2.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, how often do you practise English outside class?",
          "audio": "audio/B1/b1-e05-learning-english/p4-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it better to learn a language alone or in a group?",
          "audio": "audio/B1/b1-e05-learning-english/p4-q4.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, would you like to learn another language? Which one?",
          "audio": "audio/B1/b1-e05-learning-english/p4-q5.mp3",
          "audioMs": 4600
        }
      ]
    }
  ]
}
