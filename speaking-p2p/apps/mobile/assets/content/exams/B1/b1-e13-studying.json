  "version": 1,
  "topic": "Studying",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e13-studying/p1-intro.mp3",
          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what are you studying at the moment?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e13-studying/p1-q1.mp3",
          "audioMs": 3500
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what is your favourite subject? Why?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e13-studying/p1-q2.mp3",
          "audioMs": 4100
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about your school or college.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e13-studying/p1-q3.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer studying in the morning or in the evening?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e13-studying/p1-q4.mp3",
          "audioMs": 4800
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, where do you usually do your homework?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e13-studying/p1-q5.mp3",
          "audioMs": 3700
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what would you like to study in the future?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e13-studying/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e13-studying/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e13-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows students studying together in a library. Please tell us what you can see.",
          "audio": "audio/B1/b1-e13-studying/p2-a.mp3",
          "audioMs": 8400
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e13-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a boy studying alone in his room. Please tell us what you can see.",
          "audio": "audio/B1/b1-e13-studying/p2-b.mp3",
          "audioMs": 8300
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e13-studying/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e13-studying",
          "text": "A student has an important exam next month and wants to study better. Here are some ideas to help her. Talk together about the different ideas, and say which would be the most useful.",
          "audio": "audio/B1/b1-e13-studying/p3-discuss.mp3",
          "audioMs": 12300
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about studying and school.",
          "audio": "audio/B1/b1-e13-studying/p4-intro.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is better to study alone or in a group? Why?",
          "audio": "audio/B1/b1-e13-studying/p4-q1.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think students have too many exams?",
          "audio": "audio/B1/b1-e13-studying/p4-q2.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what makes a good teacher?",
          "audio": "audio/B1/b1-e13-studying/p4-q3.mp3",
          "audioMs": 3000
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it important to have good marks at school?",
          "audio": "audio/B1/b1-e13-studying/p4-q4.mp3",
          "audioMs": 3400
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, how do you feel before an exam?",
          "audio": "audio/B1/b1-e13-studying/p4-q5.mp3",
          "audioMs": 3600
        }
      ]
    }
  ]
}
