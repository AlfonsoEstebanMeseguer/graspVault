{
  "id": "b1-e19-places-to-stay",
  "level": "B1",
  "version": 1,
  "topic": "Places to stay",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e19-places-to-stay/p1-intro.mp3",
          "audioMs": 6800
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, have you ever stayed in a hotel?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e19-places-to-stay/p1-q1.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer staying with family or in a hotel?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e19-places-to-stay/p1-q2.mp3",
          "audioMs": 4800
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a place where you stayed that you really liked.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e19-places-to-stay/p1-q3.mp3",
          "audioMs": 5000
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what is the most important thing for you in a place to sleep?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e19-places-to-stay/p1-q4.mp3",
          "audioMs": 5100
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you like staying in other people's houses?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e19-places-to-stay/p1-q5.mp3",
          "audioMs": 4200
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, where are you going to stay on your next trip?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e19-places-to-stay/p1-q6.mp3",
          "audioMs": 3900
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e19-places-to-stay/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e19-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows tourists arriving at a hotel. Please tell us what you can see.",
          "audio": "audio/B1/b1-e19-places-to-stay/p2-a.mp3",
          "audioMs": 7900
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e19-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows young people staying in a hostel. Please tell us what you can see.",
          "audio": "audio/B1/b1-e19-places-to-stay/p2-b.mp3",
          "audioMs": 7800
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e19-places-to-stay/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e19-places-to-stay",
          "text": "A group of students is planning a trip to another country and needs a cheap place to stay. Here are some places. Talk together about the different places, and say which would be the best.",
          "audio": "audio/B1/b1-e19-places-to-stay/p3-discuss.mp3",
          "audioMs": 12000
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about hotels and places to stay.",
          "audio": "audio/B1/b1-e19-places-to-stay/p4-intro.mp3",
          "audioMs": 5700
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is better to stay in a hotel or in a flat? Why?",
          "audio": "audio/B1/b1-e19-places-to-stay/p4-q1.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, what is important when you choose where to stay?",
          "audio": "audio/B1/b1-e19-places-to-stay/p4-q2.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, have you ever had a problem in a hotel?",
          "audio": "audio/B1/b1-e19-places-to-stay/p4-q3.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Why do some people like staying in the same place every year?",
          "audio": "audio/B1/b1-e19-places-to-stay/p4-q4.mp3",
          "audioMs": 4400
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, would you like to work in a hotel?",
          "audio": "audio/B1/b1-e19-places-to-stay/p4-q5.mp3",
          "audioMs": 3500
        }
      ]
    }
  ]
}
