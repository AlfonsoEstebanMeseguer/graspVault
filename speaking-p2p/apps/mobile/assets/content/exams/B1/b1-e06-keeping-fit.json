{
  "id": "b1-e06-keeping-fit",
  "level": "B1",
  "version": 1,
  "topic": "Keeping fit",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e06-keeping-fit/p1-intro.mp3",
          "audioMs": 6500
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you do any sport?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e06-keeping-fit/p1-q1.mp3",
          "audioMs": 2900
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what sports are popular in your country?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e06-keeping-fit/p1-q2.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a time you went for a long walk or ran a race.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e06-keeping-fit/p1-q3.mp3",
          "audioMs": 5700
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer playing sport or watching it?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e06-keeping-fit/p1-q4.mp3",
          "audioMs": 4100
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how much sleep do you usually get?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e06-keeping-fit/p1-q5.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what would you like to do to be healthier?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e06-keeping-fit/p1-q6.mp3",
          "audioMs": 3800
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e06-keeping-fit/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e06-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a group of people running in a park. Please tell us what you can see.",
          "audio": "audio/B1/b1-e06-keeping-fit/p2-a.mp3",
          "audioMs": 7900
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e06-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows a woman doing exercise at home. Please tell us what you can see.",
          "audio": "audio/B1/b1-e06-keeping-fit/p2-b.mp3",
          "audioMs": 8200
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e06-keeping-fit/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e06-keeping-fit",
          "text": "A friend of yours wants to get fitter and healthier. Here are some activities he could do. Talk together about the different activities, and say which would be the best.",
          "audio": "audio/B1/b1-e06-keeping-fit/p3-discuss.mp3",
          "audioMs": 10300
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about sport and health.",
          "audio": "audio/B1/b1-e06-keeping-fit/p4-intro.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think it is better to exercise alone or with other people? Why?",
          "audio": "audio/B1/b1-e06-keeping-fit/p4-q1.mp3",
          "audioMs": 5100
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think young people do enough sport?",
          "audio": "audio/B1/b1-e06-keeping-fit/p4-q2.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what do you do to relax after a busy day?",
          "audio": "audio/B1/b1-e06-keeping-fit/p4-q3.mp3",
          "audioMs": 4300
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Why is it sometimes difficult for people to keep fit?",
          "audio": "audio/B1/b1-e06-keeping-fit/p4-q4.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, should schools have more sport lessons?",
          "audio": "audio/B1/b1-e06-keeping-fit/p4-q5.mp3",
          "audioMs": 3800
        }
      ]
    }
  ]
}
