  "topic": "Parks and gardens",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p1-intro.mp3",
          "audioMs": 6600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, is there a park near your home?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e23-parks-and-gardens/p1-q1.mp3",
          "audioMs": 3500
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you like spending time outside?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e23-parks-and-gardens/p1-q2.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about the last time you went to a park.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e23-parks-and-gardens/p1-q3.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you prefer parks with a lot of people or quiet parks?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e23-parks-and-gardens/p1-q4.mp3",
          "audioMs": 5100
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you have plants at home?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e23-parks-and-gardens/p1-q5.mp3",
          "audioMs": 3100
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what are you going to do in the park next weekend?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e23-parks-and-gardens/p1-q6.mp3",
          "audioMs": 4500
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e23-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows two older people relaxing in a park. Please tell us what you can see.",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p2-a.mp3",
          "audioMs": 8200
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e23-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows children playing in a playground. Please tell us what you can see.",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p2-b.mp3",
          "audioMs": 7900
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e23-parks-and-gardens",
          "text": "A town wants to make its old park more interesting for everybody. Here are some ideas. Talk together about the different ideas, and say which would be the best for the park.",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p3-discuss.mp3",
          "audioMs": 11100
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about parks and gardens.",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p4-intro.mp3",
          "audioMs": 4900
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think parks are important in a city? Why?",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p4-q1.mp3",
          "audioMs": 3900
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think towns should have more green spaces?",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p4-q2.mp3",
          "audioMs": 4300
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, what do you usually do in a park?",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p4-q3.mp3",
          "audioMs": 3700
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it better to have one big park or many small gardens?",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p4-q4.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, who looks after the park in your town?",
          "audio": "audio/B1/b1-e23-parks-and-gardens/p4-q5.mp3",
          "audioMs": 3900
        }
      ]
    }
  ]
}
