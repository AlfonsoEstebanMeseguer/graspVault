{
  "id": "b1-e30-taking-photos",
  "level": "B1",
  "version": 1,
  "topic": "Taking photos",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. In this test, I'm going to ask you some questions about yourselves. Let's begin.",
          "audio": "audio/B1/b1-e30-taking-photos/p1-intro.mp3",
          "audioMs": 6500
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you like taking photos?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e30-taking-photos/p1-q1.mp3",
          "audioMs": 3400
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what do you usually take photos of?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e30-taking-photos/p1-q2.mp3",
          "audioMs": 3700
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, tell us about a photo that is special to you.",
          "durationSec": 25,
          "audio": "audio/B1/b1-e30-taking-photos/p1-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, do you print your photos or keep them on your phone?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e30-taking-photos/p1-q4.mp3",
          "audioMs": 4800
        },
        {
          "id": "p1-q5",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you prefer taking photos of people or places?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e30-taking-photos/p1-q5.mp3",
          "audioMs": 5000
        },
        {
          "id": "p1-q6",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what are you going to take photos of this year?",
          "durationSec": 25,
          "audio": "audio/B1/b1-e30-taking-photos/p1-q6.mp3",
          "audioMs": 4200
        }
      ]
    },
    {
      "index": 2,
      "title": "Photograph",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "Now I'm going to give each of you a photograph. I'd like you to talk about it on your own for about one minute.",
          "audio": "audio/B1/b1-e30-taking-photos/p2-intro.mp3",
          "audioMs": 7500
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b1-e30-a1"
          ],
          "text": "Candidate A, here is your photograph. It shows a person taking a photo of mountains. Please tell us what you can see.",
          "audio": "audio/B1/b1-e30-taking-photos/p2-a.mp3",
          "audioMs": 8400
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b1-e30-b1"
          ],
          "text": "Candidate B, here is your photograph. It shows friends taking a selfie together. Please tell us what you can see.",
          "audio": "audio/B1/b1-e30-taking-photos/p2-b.mp3",
          "audioMs": 7900
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now, in this part of the test, you're going to talk about something together for about two or three minutes.",
          "audio": "audio/B1/b1-e30-taking-photos/p3-intro.mp3",
          "audioMs": 6700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 150,
          "diagram": "b1-e30-taking-photos",
          "text": "A friend of yours wants to start a photo club at school. Here are some ideas for the first meetings. Talk together about the different ideas, and say which would be the best.",
          "audio": "audio/B1/b1-e30-taking-photos/p3-discuss.mp3",
          "audioMs": 11200
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about photography.",
          "audio": "audio/B1/b1-e30-taking-photos/p4-intro.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Do you think taking photos is a good way to remember special moments? Why?",
          "audio": "audio/B1/b1-e30-taking-photos/p4-q1.mp3",
          "audioMs": 5600
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 40,
          "text": "Candidate A, do you think people take too many photos nowadays?",
          "audio": "audio/B1/b1-e30-taking-photos/p4-q2.mp3",
          "audioMs": 4700
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, do you share your photos on the internet?",
          "audio": "audio/B1/b1-e30-taking-photos/p4-q3.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 45,
          "text": "Is it better to enjoy a moment or to take a photo of it?",
          "audio": "audio/B1/b1-e30-taking-photos/p4-q4.mp3",
          "audioMs": 4200
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "B",
          "durationSec": 40,
          "text": "Candidate B, who in your family takes the best photos?",
          "audio": "audio/B1/b1-e30-taking-photos/p4-q5.mp3",
          "audioMs": 4200
        }
      ]
    }
  ]
}
