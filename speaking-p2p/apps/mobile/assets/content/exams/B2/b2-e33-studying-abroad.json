{
  "id": "b2-e33-studying-abroad",
  "level": "B2",
  "version": 1,
  "topic": "Studying abroad",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good morning. First of all, we'd like to know something about you.",
          "audio": "audio/B2/b2-e33-studying-abroad/p1-intro.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, would you like to study in another country?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e33-studying-abroad/p1-q1.mp3",
          "audioMs": 4100
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, where would you most like to live for a year?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e33-studying-abroad/p1-q2.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what languages would you like to learn?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e33-studying-abroad/p1-q3.mp3",
          "audioMs": 4000
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, have you ever lived away from home?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e33-studying-abroad/p1-q4.mp3",
          "audioMs": 3600
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you two photographs. I'd like you to talk about them on your own for about a minute, and also to answer a question about your partner's photographs.",
          "audio": "audio/B2/b2-e33-studying-abroad/p2-intro.mp3",
          "audioMs": 13000
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b2-e33-a1",
            "b2-e33-a2"
          ],
          "text": "Candidate A, your photographs show young people studying away from home. Compare the photographs, and say how the people might be feeling.",
          "audio": "audio/B2/b2-e33-studying-abroad/p2-a.mp3",
          "audioMs": 9200
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, would you like to have this kind of experience? Why or why not?",
          "audio": "audio/B2/b2-e33-studying-abroad/p2-a-follow.mp3",
          "audioMs": 5500
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b2-e33-b1",
            "b2-e33-b2"
          ],
          "text": "Candidate B, your photographs show students in a foreign country. Compare the photographs, and say what difficulties the students might have.",
          "audio": "audio/B2/b2-e33-studying-abroad/p2-b.mp3",
          "audioMs": 9600
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, which of these situations would be more difficult for you?",
          "audio": "audio/B2/b2-e33-studying-abroad/p2-b-follow.mp3",
          "audioMs": 5100
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some things that can help students settle in a new country, and a question for you to discuss.",
          "audio": "audio/B2/b2-e33-studying-abroad/p3-intro.mp3",
          "audioMs": 11000
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "b2-e33-studying-abroad",
          "text": "Talk to each other about this question: How might these things help a student in a new country?",
          "audio": "audio/B2/b2-e33-studying-abroad/p3-discuss.mp3",
          "audioMs": 6500
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "b2-e33-studying-abroad",
          "text": "Now you have about a minute to decide together. Which would be the most useful?",
          "audio": "audio/B2/b2-e33-studying-abroad/p3-decide.mp3",
          "audioMs": 5400
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about studying abroad.",
          "audio": "audio/B2/b2-e33-studying-abroad/p4-intro.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Some people say that studying abroad is the best way to grow up. What do you think?",
          "audio": "audio/B2/b2-e33-studying-abroad/p4-q1.mp3",
          "audioMs": 5800
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, do you think students who go abroad should come back to their own country afterwards?",
          "audio": "audio/B2/b2-e33-studying-abroad/p4-q2.mp3",
          "audioMs": 6700
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, what is the best way to deal with feeling homesick?",
          "audio": "audio/B2/b2-e33-studying-abroad/p4-q3.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Should universities charge international students more?",
          "audio": "audio/B2/b2-e33-studying-abroad/p4-q4.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, how can living in another country change a person?",
          "audio": "audio/B2/b2-e33-studying-abroad/p4-q5.mp3",
          "audioMs": 4600
        }
      ]
    }
  ]
}
