{
  "id": "b2-e17-languages-and-cultures",
  "level": "B2",
  "version": 1,
  "topic": "Languages and cultures",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. First of all, we'd like to know something about you.",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p1-intro.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how many languages do you speak?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e17-languages-and-cultures/p1-q1.mp3",
          "audioMs": 3600
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, why did you decide to learn English?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e17-languages-and-cultures/p1-q2.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, have you ever had a conversation with someone from a different culture?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e17-languages-and-cultures/p1-q3.mp3",
          "audioMs": 5300
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what do you find most difficult about learning a language?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e17-languages-and-cultures/p1-q4.mp3",
          "audioMs": 4900
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you two photographs. I'd like you to talk about them on your own for about a minute, and also to answer a question about your partner's photographs.",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p2-intro.mp3",
          "audioMs": 13000
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b2-e17-a1",
            "b2-e17-a2"
          ],
          "text": "Candidate A, your photographs show people learning languages. Compare the photographs, and say what the advantages of learning in these ways might be.",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p2-a.mp3",
          "audioMs": 10200
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, which way do you think is more effective? Why?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p2-a-follow.mp3",
          "audioMs": 4700
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b2-e17-b1",
            "b2-e17-b2"
          ],
          "text": "Candidate B, your photographs show people communicating with people from other cultures. Compare the photographs, and say what difficulties the people might have.",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p2-b.mp3",
          "audioMs": 10900
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, have you ever been in a similar situation?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p2-b-follow.mp3",
          "audioMs": 4400
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some ways to learn about another culture, and a question for you to discuss.",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p3-intro.mp3",
          "audioMs": 9900
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "b2-e17-languages-and-cultures",
          "text": "Talk to each other about this question: How might these experiences help people understand another culture?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p3-discuss.mp3",
          "audioMs": 7500
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "b2-e17-languages-and-cultures",
          "text": "Now you have about a minute to decide together. Which would give the best understanding?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p3-decide.mp3",
          "audioMs": 6000
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about languages and cultures.",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p4-intro.mp3",
          "audioMs": 5400
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Some people say that one day everybody will speak the same language. What do you think?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p4-q1.mp3",
          "audioMs": 5800
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, do you think it is important to protect small languages?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p4-q2.mp3",
          "audioMs": 5000
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, why do some people feel embarrassed when speaking a foreign language?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p4-q3.mp3",
          "audioMs": 5700
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Is it possible to understand a culture without speaking its language?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p4-q4.mp3",
          "audioMs": 4800
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, should schools teach more than one foreign language?",
          "audio": "audio/B2/b2-e17-languages-and-cultures/p4-q5.mp3",
          "audioMs": 4600
        }
      ]
    }
  ]
}
