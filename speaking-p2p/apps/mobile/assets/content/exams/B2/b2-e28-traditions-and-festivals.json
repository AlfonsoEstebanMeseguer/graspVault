{
  "id": "b2-e28-traditions-and-festivals",
  "level": "B2",
  "version": 1,
  "topic": "Traditions and festivals",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. First of all, we'd like to know something about you.",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p1-intro.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what is the most important festival in your country?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p1-q1.mp3",
          "audioMs": 4900
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, how do you usually celebrate it?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p1-q2.mp3",
          "audioMs": 3500
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you enjoy being in big crowds?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p1-q3.mp3",
          "audioMs": 3800
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, have you ever been to a festival in another country?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p1-q4.mp3",
          "audioMs": 4900
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you two photographs. I'd like you to talk about them on your own for about a minute, and also to answer a question about your partner's photographs.",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p2-intro.mp3",
          "audioMs": 13000
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b2-e28-a1",
            "b2-e28-a2"
          ],
          "text": "Candidate A, your photographs show people celebrating traditions. Compare the photographs, and say why these traditions might be important to the people.",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p2-a.mp3",
          "audioMs": 10600
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, which tradition would you prefer to take part in? Why?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p2-a-follow.mp3",
          "audioMs": 5200
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b2-e28-b1",
            "b2-e28-b2"
          ],
          "text": "Candidate B, your photographs show people taking part in a local event. Compare the photographs, and say what the people might enjoy.",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p2-b.mp3",
          "audioMs": 9300
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, do you think young people are interested in old traditions?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p2-b-follow.mp3",
          "audioMs": 5300
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some ways to keep old traditions alive, and a question for you to discuss.",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p3-intro.mp3",
          "audioMs": 10100
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "b2-e28-traditions-and-festivals",
          "text": "Talk to each other about this question: How might these ideas help keep traditions alive?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p3-discuss.mp3",
          "audioMs": 6500
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "b2-e28-traditions-and-festivals",
          "text": "Now you have about a minute to decide together. Which would be the most effective?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p3-decide.mp3",
          "audioMs": 5700
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about traditions and festivals.",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p4-intro.mp3",
          "audioMs": 5400
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Some people say that traditions are not important in modern life. What do you think?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p4-q1.mp3",
          "audioMs": 5800
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, do you think tourism is changing the traditions of your country?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p4-q2.mp3",
          "audioMs": 5800
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, should some old traditions be stopped because they hurt animals?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p4-q3.mp3",
          "audioMs": 5600
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Is it good that festivals from other countries are becoming popular around the world?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p4-q4.mp3",
          "audioMs": 5800
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, what tradition would you like to start in your own family?",
          "audio": "audio/B2/b2-e28-traditions-and-festivals/p4-q5.mp3",
          "audioMs": 5100
        }
      ]
    }
  ]
}
