{
  "id": "b2-e34-public-spaces",
  "level": "B2",
  "version": 1,
  "topic": "Public spaces",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good afternoon. First of all, we'd like to know something about you.",
          "audio": "audio/B2/b2-e34-public-spaces/p1-intro.mp3",
          "audioMs": 4600
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, what do you like about your town centre?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e34-public-spaces/p1-q1.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, where do you go to relax in your town?",
          "durationSec": 25,
          "audio": "audio/B2/b2-e34-public-spaces/p1-q2.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how often do you go to parks or squares?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e34-public-spaces/p1-q3.mp3",
          "audioMs": 4100
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, what is the most interesting building in your town?",
          "durationSec": 30,
          "audio": "audio/B2/b2-e34-public-spaces/p1-q4.mp3",
          "audioMs": 4600
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you two photographs. I'd like you to talk about them on your own for about a minute, and also to answer a question about your partner's photographs.",
          "audio": "audio/B2/b2-e34-public-spaces/p2-intro.mp3",
          "audioMs": 13000
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "b2-e34-a1",
            "b2-e34-a2"
          ],
          "text": "Candidate A, your photographs show public places in a city. Compare the photographs, and say what the advantages and disadvantages of these places might be.",
          "audio": "audio/B2/b2-e34-public-spaces/p2-a.mp3",
          "audioMs": 11500
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, which of these places would you prefer to spend time in?",
          "audio": "audio/B2/b2-e34-public-spaces/p2-a-follow.mp3",
          "audioMs": 5000
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "b2-e34-b1",
            "b2-e34-b2"
          ],
          "text": "Candidate B, your photographs show people using public spaces. Compare the photographs, and say why the people might have chosen these places.",
          "audio": "audio/B2/b2-e34-public-spaces/p2-b.mp3",
          "audioMs": 9900
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, do you use public spaces like these?",
          "audio": "audio/B2/b2-e34-public-spaces/p2-b-follow.mp3",
          "audioMs": 4000
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some things that can make a public space attractive, and a question for you to discuss.",
          "audio": "audio/B2/b2-e34-public-spaces/p3-intro.mp3",
          "audioMs": 10700
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "b2-e34-public-spaces",
          "text": "Talk to each other about this question: How might these things make a public space popular?",
          "audio": "audio/B2/b2-e34-public-spaces/p3-discuss.mp3",
          "audioMs": 6100
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "b2-e34-public-spaces",
          "text": "Now you have about a minute to decide together. Which is the most important for a new square?",
          "audio": "audio/B2/b2-e34-public-spaces/p3-decide.mp3",
          "audioMs": 6400
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about public spaces in the city.",
          "audio": "audio/B2/b2-e34-public-spaces/p4-intro.mp3",
          "audioMs": 5700
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Some people say that cities have too few places for young people. What do you think?",
          "audio": "audio/B2/b2-e34-public-spaces/p4-q1.mp3",
          "audioMs": 5600
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, do you think public spaces should be free from advertising?",
          "audio": "audio/B2/b2-e34-public-spaces/p4-q2.mp3",
          "audioMs": 5300
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, who should look after public parks and squares?",
          "audio": "audio/B2/b2-e34-public-spaces/p4-q3.mp3",
          "audioMs": 4300
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "How do public spaces help to bring a community together?",
          "audio": "audio/B2/b2-e34-public-spaces/p4-q4.mp3",
          "audioMs": 4200
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, what is the best public space you have ever visited?",
          "audio": "audio/B2/b2-e34-public-spaces/p4-q5.mp3",
          "audioMs": 4700
        }
      ]
    }
  ]
}
