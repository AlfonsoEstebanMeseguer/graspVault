{
  "id": "c1-e35-competition-or-cooperation",
  "level": "C1",
  "version": 1,
  "topic": "Competition or cooperation",
  "parts": [
    {
      "index": 1,
      "title": "Interview",
      "steps": [
        {
          "id": "p1-intro",
          "kind": "narration",
          "text": "Good evening. First of all, we'd like to know a little about you.",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p1-intro.mp3",
          "audioMs": 4400
        },
        {
          "id": "p1-q1",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, do you work better when you are competing or cooperating?",
          "durationSec": 25,
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p1-q1.mp3",
          "audioMs": 5100
        },
        {
          "id": "p1-q2",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, did you enjoy competing at school?",
          "durationSec": 25,
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p1-q2.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q3",
          "kind": "turn",
          "target": "A",
          "text": "Candidate A, how important is it to you to win?",
          "durationSec": 30,
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p1-q3.mp3",
          "audioMs": 3900
        },
        {
          "id": "p1-q4",
          "kind": "turn",
          "target": "B",
          "text": "Candidate B, have you ever had a difficult experience of working with others?",
          "durationSec": 30,
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p1-q4.mp3",
          "audioMs": 5200
        }
      ]
    },
    {
      "index": 2,
      "title": "Long turn",
      "steps": [
        {
          "id": "p2-intro",
          "kind": "narration",
          "text": "In this part of the test, I'm going to give each of you three pictures. I'd like you to talk about two of them on your own for about a minute, and also to answer a question briefly about your partner's pictures.",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p2-intro.mp3",
          "audioMs": 13200
        },
        {
          "id": "p2-a",
          "kind": "turn",
          "target": "A",
          "durationSec": 60,
          "assets": [
            "c1-e35-a1",
            "c1-e35-a2",
            "c1-e35-a3"
          ],
          "text": "Candidate A, your pictures show people competing or cooperating. Choose two of the pictures and say what the people are trying to achieve, and what they might gain or lose.",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p2-a.mp3",
          "audioMs": 11700
        },
        {
          "id": "p2-a-follow",
          "kind": "turn",
          "target": "B",
          "durationSec": 30,
          "text": "Candidate B, which of these situations do you think brings out the best in people?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p2-a-follow.mp3",
          "audioMs": 5900
        },
        {
          "id": "p2-b",
          "kind": "turn",
          "target": "B",
          "durationSec": 60,
          "assets": [
            "c1-e35-b1",
            "c1-e35-b2",
            "c1-e35-b3"
          ],
          "text": "Candidate B, your pictures show people performing in front of others. Choose two of the pictures and say how the people might feel, and what skills they need.",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p2-b.mp3",
          "audioMs": 10400
        },
        {
          "id": "p2-b-follow",
          "kind": "turn",
          "target": "A",
          "durationSec": 30,
          "text": "Candidate A, are you more comfortable performing alone or in a group?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p2-b-follow.mp3",
          "audioMs": 5000
        }
      ]
    },
    {
      "index": 3,
      "title": "Collaborative task",
      "steps": [
        {
          "id": "p3-intro",
          "kind": "narration",
          "text": "Now I'd like you to talk about something together for about two minutes. Here are some effects that competition can have in a school or workplace, and a question for you to discuss.",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p3-intro.mp3",
          "audioMs": 11600
        },
        {
          "id": "p3-discuss",
          "kind": "open",
          "target": "both",
          "durationSec": 120,
          "diagram": "c1-e35-competition-or-cooperation",
          "text": "Talk to each other about this question: How might competition affect the people involved?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p3-discuss.mp3",
          "audioMs": 6100
        },
        {
          "id": "p3-decide",
          "kind": "open",
          "target": "both",
          "durationSec": 60,
          "diagram": "c1-e35-competition-or-cooperation",
          "text": "Now you have about a minute to decide together. Which effect is the most important?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p3-decide.mp3",
          "audioMs": 5900
        }
      ]
    },
    {
      "index": 4,
      "title": "Discussion",
      "steps": [
        {
          "id": "p4-intro",
          "kind": "narration",
          "text": "Now I'd like to ask you some more questions about competition and cooperation.",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p4-intro.mp3",
          "audioMs": 6000
        },
        {
          "id": "p4-q1",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "To what extent is competition necessary for progress?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p4-q1.mp3",
          "audioMs": 4100
        },
        {
          "id": "p4-q2",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, should schools do away with rankings and prizes?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p4-q2.mp3",
          "audioMs": 4500
        },
        {
          "id": "p4-q3",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, is it possible for a company to succeed through cooperation rather than competition?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p4-q3.mp3",
          "audioMs": 7200
        },
        {
          "id": "p4-q4",
          "kind": "open",
          "target": "both",
          "durationSec": 50,
          "text": "Do you think competition brings out the worst in people?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p4-q4.mp3",
          "audioMs": 4000
        },
        {
          "id": "p4-q5",
          "kind": "open",
          "target": "A",
          "durationSec": 45,
          "text": "Candidate A, how can parents teach children to cope with losing?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p4-q5.mp3",
          "audioMs": 4600
        },
        {
          "id": "p4-q6",
          "kind": "open",
          "target": "B",
          "durationSec": 45,
          "text": "Candidate B, are countries better off when they cooperate or when they compete?",
          "audio": "audio/C1/c1-e35-competition-or-cooperation/p4-q6.mp3",
          "audioMs": 5600
        }
      ]
    }
  ]
}
