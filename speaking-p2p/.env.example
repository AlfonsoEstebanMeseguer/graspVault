# Names only. Real values live in: Supabase project secrets (Edge Functions),
# Supabase Vault (DB-side secrets), the CI secret store, and --dart-define for the app.
# Never paste a value in a chat or commit it (docs/VAULT_NOTES.md, "higiene de secretos").
#
# The Deno runtime reads apps/backend/supabase/functions/.env, NOT this file (vault trap).

# --- Supabase (Edge Functions; SUPABASE_URL / SERVICE_ROLE_KEY are injected by the platform)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=      # Web client id (also used as serverClientId in the app)
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- LiveKit (audio only)
LIVEKIT_URL=                                  # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare R2 (endpoint WITHOUT bucket; EU buckets need the .eu. endpoint)
R2_ENDPOINT=                                  # https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=                             # token with read+write on the media bucket
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=                              # avatars (private, signed URLs)
R2_RECORDINGS_BUCKET=                         # exam recordings, lifecycle rule: delete after 30 days
R2_RECORDINGS_ACCESS_KEY_ID=                  # SEPARATE token scoped to the recordings bucket (handed to LiveKit Egress)
R2_RECORDINGS_SECRET_ACCESS_KEY=
CONTENT_CDN_URL=                              # public custom domain of the content bucket (audio/, img/)

# --- Internal callers: store only the SHA-256 (hex) of the secret
INTERNAL_CRON_TOKEN_SHA256=                   # the token itself lives in Supabase Vault as internal_cron_token
REVENUECAT_WEBHOOK_AUTH_SHA256=               # sha256 of the Authorization value configured in RevenueCat

# --- Push
FCM_SERVICE_ACCOUNT_JSON=

# --- Observability
SENTRY_DSN_FUNCTIONS=

# --- App (passed with --dart-define-from-file=env/dev.json, never committed)
# SUPABASE_URL, SUPABASE_ANON_KEY, GOOGLE_WEB_CLIENT_ID, GOOGLE_IOS_CLIENT_ID,
# REVENUECAT_API_KEY_APPLE, REVENUECAT_API_KEY_GOOGLE, ADMOB_APP_OPEN_ID_ANDROID, ADMOB_APP_OPEN_ID_IOS,
# SENTRY_DSN_APP, POSTHOG_API_KEY, POSTHOG_HOST, CONTENT_CDN_URL
