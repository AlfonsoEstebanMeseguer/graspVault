# Names only. Real values live in: Supabase project secrets (Edge Functions),
# Supabase Vault (DB-side secrets), the CI secret store, and --dart-define for the app.
# Never paste a value in a chat or commit it (docs/VAULT_NOTES.md, "higiene de secretos").
#
# The Deno runtime reads apps/backend/supabase/functions/.env, NOT this file (vault trap).

# --- Supabase (Edge Functions; SUPABASE_URL / SERVICE_ROLE_KEY are injected by the platform)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Google sign-in postponed (D-022): SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID / _SECRET

# --- LiveKit (audio only)
LIVEKIT_URL=                                  # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare R2: one endpoint per bucket, WITH the bucket as the path (no separate *_BUCKET vars)
R2_ENDPOINT_SPEAKING_MEDIA=                   # https://<account>.r2.cloudflarestorage.com/speaking-media (avatars, private)
R2_ENDPOINT_SPEAKING_CONTENT=                 # .../speaking-content (exam audio + photos; signed URLs until a CDN domain exists)
R2_ENDPOINT_SPEAKING_RECORDINGS=              # .../speaking-recordings (lifecycle: delete after 30 days)
R2_MEDIA_ACCESS_KEY=                          # token for media + content
R2_MEDIA_SECRET_KEY=
R2_RECORDINGS_ACCESS_KEY=                     # separate token, handed to LiveKit Egress
R2_RECORDINGS_SECRET_KEY=

# --- Internal callers
# The cron token lives ONLY in Supabase Vault (internal_cron_token); the database verifies it (D-021).
REVENUECAT_WEBHOOK_AUTH_SHA256=               # postponed with RevenueCat

# --- Push
FCM_SERVICE_ACCOUNT_JSON=

# --- Observability
SENTRY_DSN_FUNCTIONS=

# --- App (passed with --dart-define-from-file=env/dev.json, never committed)
# SUPABASE_URL, SUPABASE_ANON_KEY, GOOGLE_WEB_CLIENT_ID, GOOGLE_IOS_CLIENT_ID,
# REVENUECAT_API_KEY_APPLE, REVENUECAT_API_KEY_GOOGLE, ADMOB_APP_OPEN_ID_ANDROID, ADMOB_APP_OPEN_ID_IOS,
# SENTRY_DSN_APP, POSTHOG_API_KEY, POSTHOG_HOST, CONTENT_CDN_URL

# --- Content scripts (scripts/content/photos_pixabay.py, local only)
PIXABAY_API_KEY=
OPENAI_API_KEY=